PORT=3000
NODE_ID=node-1

# Java 认证接口
AUTH_VALIDATE_URL=http://localhost:8080/internal/session/validate
AUTH_TOKEN_VALIDATE_URL=http://localhost:8080/internal/token/validate
SESSION_COOKIE_NAME=session
AUTH_TIMEOUT_MS=3000
# 本地调试：跳过认证，直接用 accessToken 作为 userId
DEV_AUTH_BYPASS=false

# Redis（本地）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 阿里云 RocketMQ 5.0
ROCKETMQ_ENDPOINTS=rmq-cn-xxxxxx.cn-hangzhou.rmq.aliyuncs.com:8080
ROCKETMQ_CONSUMER_GROUP=ws-gateway-group
ROCKETMQ_TOPIC=stake-ws-push
ROCKETMQ_TAG=*
ROCKETMQ_ACCESS_KEY=your_access_key
ROCKETMQ_ACCESS_SECRET=your_access_secret
